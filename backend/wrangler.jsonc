{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forum-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forum-db",
      "database_id": "c71a2c00-f5ba-49f8-90bd-8fe0d8a26b39"
    },
    {
      "binding": "GAME_DB",
      "database_name": "game-db",
      "database_id": "916c3765-4b1c-494b-b7d9-e1b82a6b048b"
    }
  ],
  // ============================================================
  // 图片存储（Cloudflare KV，替代 R2 与第三方图床）
  // 免费额度：1 GB 存储 / 1000 次写每天 / 10 万次读每天 / 单 value 25 MiB
  // 写入：POST /api/posts/upload 或 /api/game/posts/upload   读取：GET /img/:id
  // 图片永久保存（不设 expirationTtl），存满再处理
  // ============================================================
  "kv_namespaces": [
    {
      "binding": "IMG_KV",
      "id": "f677e3ee4a4a4484b2dc54aa6ce0de1"
    }
  ],
  "vars": {}
}
